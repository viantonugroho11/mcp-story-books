STORYBOOK_BASE_URL=https://amt-fds-prod.vercel.app

# Discovered: Vercel deployment protection uses HTTP Basic Auth (401 + WWW-Authenticate: Basic).
STORYBOOK_AUTH_TYPE=basic

# Basic auth (Vercel deployment protection)
STORYBOOK_BASIC_AUTH_USERNAME=
STORYBOOK_BASIC_AUTH_PASSWORD=

# Optional app-level auth (set after running npm run discover if the app uses another layer)
# STORYBOOK_AUTH_TYPE=bearer
# STORYBOOK_ACCESS_TOKEN=

# STORYBOOK_AUTH_TYPE=cookie
# STORYBOOK_SESSION_COOKIE=

# HTTP client
STORYBOOK_REQUEST_TIMEOUT_MS=30000
STORYBOOK_MAX_RESPONSE_BYTES=5242880
STORYBOOK_MAX_RETRIES=3

# Cache
CACHE_ENABLED=true
CACHE_TTL=300

# Optional: path to discovery output from `npm run discover`
# STORYBOOK_DISCOVERY_PATH=./discovery-output.json

# auto | storybook-static | rest-api
STORYBOOK_DATA_SOURCE=auto

# Optional manual API overrides (rest-api mode only)
# STORYBOOK_API_LIST_STORIES=/api/stories
# STORYBOOK_API_GET_STORY=/api/stories/{storyId}
# STORYBOOK_API_SEARCH=/api/stories/search
