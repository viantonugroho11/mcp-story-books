{
  "name": "fds-storybook-mcp",
  "version": "0.1.0",
  "description": "Read-only MCP server for authenticated FDS Story Book",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "fds-storybook-mcp": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
